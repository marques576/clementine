# Public base URL used in the generated /llms.txt and /instructions.md.
#
# Copy this file to `.env` and set your domain (works for any host, including
# a VPS):
#   VITE_SITE_URL=https://convert.example.com
#
# If unset, it falls back to http://localhost:3000 for local development.
VITE_SITE_URL=http://localhost:3000
